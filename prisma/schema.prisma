// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
//core tables being used 

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionCadence {
  MONTHLY
  YEARLY
  CUSTOM
}

enum DetectedItemType {
  TRIAL
  RENEWAL
  BILL
}

enum DetectedItemStatus {
  NEW
  CONFIRMED
  DISMISSED
}

enum RuleType {
  RENEWAL_REMINDER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum ReturnStatus {
  NOT_STARTED
  PACKED
  DROPPED_OFF
  DELIVERED
  REFUNDED
}

enum ValueEventType {
  AVOIDED_RENEWAL
  REFUND_RECEIVED
  FEE_AVOIDED
}

model Subscription {
  id          String              @id @default(cuid())
  userId      String // Clerk userId
  name        String
  amountCents Int
  currency    String              @default("CAD")
  renewalDate DateTime
  cadence     SubscriptionCadence @default(MONTHLY)
  status      SubscriptionStatus  @default(ACTIVE)
  cancelUrl   String?
  notes       String?
  trialEndAt  DateTime?
  renewalAt   DateTime?
  renewalCadence SubscriptionCadence?
  cancelInstructions String?
  merchantCanonicalId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  detectedItems DetectedItem[]

  @@index([userId, renewalDate])
}

model ReturnItem {
  id               String       @id @default(cuid())
  userId           String
  purchaseId       String?
  store            String
  itemNote         String?
  amountCents      Int?
  currency         String       @default("CAD")
  purchaseDate     DateTime
  returnWindowDays Int          @default(30)
  returnBy         DateTime
  status           ReturnStatus @default(NOT_STARTED)

  trackingNumber    String?
  carrier           String?
  dropoffDate       DateTime? // when returned/shipped
  deliveredAt       DateTime?
  refundExpectedAt  DateTime? // when you expect refund by
  refundedDate      DateTime? // when refund actually received
  refundAmountCents Int? // OPTIONAL (nice to have)
  refundSlaDays     Int       @default(14)
  refundType        String?   @default("ORIGINAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipmentEvents ShipmentEvent[] @relation("ReturnItemShipmentEvents")
  refundCase      RefundCase?     @relation("ReturnItemRefundCase")
  purchase        Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([userId, returnBy])
  @@index([userId, refundExpectedAt]) // optional but helpful
}

//schema for adding bill paid status
enum BillStatus {
  ACTIVE
  PAUSED
}

model Bill {
  id            String     @id @default(cuid())
  userId        String
  name          String
  amountCents   Int?
  currency      String     @default("CAD")
  dueDayOfMonth Int // 1..31
  autopay       Boolean    @default(false)
  payee         String?
  notes         String?
  status        BillStatus @default(ACTIVE)

  payments    BillPayment[]
  occurrences BillOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model BillPayment {
  id          String    @id @default(cuid())
  userId      String
  billId      String
  monthKey    String // "YYYY-MM"
  dueDate     DateTime
  paidAt      DateTime?
  amountCents Int?
  currency    String    @default("CAD")
  notes       String?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([billId, monthKey])
  @@index([userId, monthKey])
}

enum Plan {
  FREE
  PRO
}

//data model for billing state
model BillingAccount {
  id     String @id @default(cuid())
  userId String @unique
  plan   Plan   @default(FREE)

  preferredCurrency String? @default("CAD")

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  stripeStatus         String?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plan])
}

model WebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

enum EmailProvider {
  GMAIL
  UPLOAD
}

enum PurchaseSource {
  GMAIL
  UPLOAD
  MANUAL
}

enum ScanMode {
  ALL
  RECEIPTS_ONLY
  SHIPPING_ONLY
  SUBSCRIPTIONS_ONLY
}

enum DataDeletionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Snoozed calendar events (per user, per event id, until a UTC date)
model SnoozedEvent {
  id           String   @id @default(cuid())
  userId       String
  eventId      String
  snoozedUntil DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([userId, snoozedUntil])
}

enum ReceiptUploadStatus {
  PARSED
  NEEDS_REVIEW
  FAILED
}

model ReceiptUpload {
  id     String @id @default(cuid())
  userId String

  filename    String
  contentType String
  sizeBytes   Int
  storagePath String

  status    ReceiptUploadStatus @default(NEEDS_REVIEW)
  extracted Json?
  error     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Purchase {
  id            String         @id @default(cuid())
  userId        String
  merchant      String
  totalCents    Int?
  currency      String         @default("CAD")
  purchasedAt   DateTime
  orderNumber   String?
  paymentMethod String?
  source        PurchaseSource @default(GMAIL)
  sourceEmailId String?

  items       PurchaseItem[]
  attachments PurchaseAttachment[]
  returns     ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, purchasedAt])
  @@index([userId, merchant])
  @@unique([userId, sourceEmailId])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  title       String
  qty         Int?
  priceCents  Int?
  currency    String  @default("CAD")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model PurchaseAttachment {
  id            String   @id @default(cuid())
  purchaseId    String
  storageKey    String
  mime          String?
  sha256        String?
  sourceEmailId String?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([purchaseId])
  @@unique([purchaseId, storageKey])
}

enum SuggestionStatus {
  NEW
  CONFIRMED
  IGNORED
}

enum SuggestionType {
  RETURN
  SUBSCRIPTION
  BILL
}

model EmailConnection {
  id       String        @id @default(cuid())
  userId   String        @unique
  provider EmailProvider @default(GMAIL)

  emailAddress String?
  accessToken  String?
  refreshToken String?
  expiry       DateTime?
  scope        String?
  scopes       String?
  lastScanAt   DateTime?
  scanMode     ScanMode     @default(ALL)
  imapUser     String?
  imapPassword String?
  imapHost     String?
  imapPort     Int?
  imapSecure   Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DataDeletionJob {
  id          String             @id @default(cuid())
  userId      String
  requestedAt DateTime           @default(now())
  status      DataDeletionStatus @default(PENDING)
  completedAt DateTime?
  error       String?

  @@index([userId, status])
}

model EmailMessage {
  id       String        @id // Gmail messageId
  userId   String
  provider EmailProvider @default(GMAIL)

  threadId     String?
  internalDate DateTime?
  fromEmail    String?
  subject      String?
  snippet      String?

  createdAt DateTime @default(now())

  @@index([userId, provider])
}

model AutomationSuggestion {
  id       String        @id @default(cuid())
  userId   String
  provider EmailProvider @default(GMAIL)

  primaryMessageId String? // optional message used as dedupe key

  type   SuggestionType
  status SuggestionStatus @default(NEW)

  merchant     String
  amountCents  Int?
  currency     String   @default("CAD")
  detectedDate DateTime

  confidence String
  reasons    Json
  messageIds Json
  draft      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, primaryMessageId])
  @@index([userId, status])
  @@index([userId, type])
}

model DetectedItem {
  id            String             @id @default(cuid())
  userId        String
  type          DetectedItemType
  merchant      String
  amountCents   Int?
  currency      String             @default("CAD")
  date          DateTime
  confidence    String
  sourceEmailId String?
  rawSnippetHash String
  status        DetectedItemStatus @default(NEW)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, date])
  @@index([userId, merchant])
}

model UserRule {
  id        String   @id @default(cuid())
  userId    String
  ruleType  RuleType
  daysBefore Int
  channels  NotificationChannel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, ruleType])
}

model EmailTransaction {
  id       String        @id @default(cuid())
  userId   String
  provider EmailProvider @default(GMAIL)

  messageId String
  merchant  String
  fromEmail String?
  subject   String?

  purchasedAt DateTime?
  orderId     String?
  totalCents  Int?
  currency    String    @default("CAD")
  items       Json?
  rawSource   String
  parserError String? // Store parser errors for debugging

  receiptDocuments ReceiptDocument[]

  createdAt DateTime @default(now())

  @@unique([provider, messageId])
  @@index([userId, merchant])
  @@index([userId, purchasedAt])
}

model ReceiptDocument {
  id                 String           @id @default(cuid())
  userId             String
  emailTransactionId String
  emailTransaction   EmailTransaction @relation(fields: [emailTransactionId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  storagePath String // URL or S3 path
  sizeBytes   Int

  createdAt DateTime @default(now())

  @@index([userId, emailTransactionId])
}

model SubscriptionPayment {
  id             String @id @default(cuid())
  userId         String
  subscriptionId String

  paidAt      DateTime
  amountCents Int
  currency    String   @default("CAD")
  notes       String?

  createdAt DateTime @default(now())

  @@index([userId, subscriptionId, paidAt])
}

enum BillOccurrenceStatus {
  DUE
  PAID
}

model BillOccurrence {
  id     String @id @default(cuid())
  userId String
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  dueDate     DateTime
  status      BillOccurrenceStatus @default(DUE)
  paidAt      DateTime?
  amountCents Int?
  currency    String               @default("CAD")

  createdAt DateTime @default(now())

  @@unique([billId, dueDate])
  @@index([userId, dueDate])
  @@index([userId, status])
}

enum NotificationType {
  SUBSCRIPTION_RENEWAL_SOON
  RETURN_DEADLINE_SOON
  BILL_DUE_SOON
  REFUND_CHECK_DUE
  REFUND_OVERDUE
  RETURN_DELIVERED
}

enum NotificationChannel {
  EMAIL_DIGEST
  EMAIL_IMMEDIATE
}

enum NotificationJobStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELED
}

model Notification {
  id     String @id @default(cuid())
  userId String

  type  NotificationType
  title String
  body  String?

  // Date of the underlying event (renewal/return/bill/refund-check)
  eventDate DateTime?

  // Date we intended to notify (usually "today" when cron runs)
  scheduledFor DateTime

  // Source reference
  sourceKind String
  sourceId   String

  // Deterministic key to dedupe notifications
  eventKey String

  readAt      DateTime?
  dismissedAt DateTime?
  emailedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs NotificationJob[]

  @@unique([userId, eventKey])
  @@index([userId, scheduledFor])
  @@index([userId, readAt])
  @@index([userId, dismissedAt])
}

model NotificationJob {
  id      String                @id @default(cuid())
  userId  String
  channel NotificationChannel
  status  NotificationJobStatus @default(PENDING)

  sendAt    DateTime // when it should be sent (UTC)
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?

  // concurrency / claiming
  lockedAt DateTime?
  lockId   String? // random run id

  // tie back to what this job is about
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  // dedupe: one job per "thing" per channel per sendAt bucket
  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dedupeKey])
  @@index([status, sendAt])
  @@index([userId, sendAt])
}

model NotificationPreference {
  userId             String  @id
  emailDigestEnabled Boolean @default(false)
  timezone           String  @default("America/Toronto")
  digestHourLocal    Int     @default(9) // 0..23
  windowDays         Int     @default(14)
  subLeadDays        Int     @default(3)
  returnLeadDays     Int     @default(2)
  billLeadDays       Int     @default(2)
  primaryEmail       String?
  notifyOnDelivery   Boolean @default(true)
  notifyOnRefundOverdue Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DigestSendLog {
  id        String   @id @default(cuid())
  userId    String
  dateLocal String // "YYYY-MM-DD" in user’s timezone
  sentAt    DateTime @default(now())

  // Idempotency
  @@unique([userId, dateLocal])
  @@index([userId, sentAt])
}

model DigestRun {
  id         String   @id @default(cuid())
  userId     String
  digestDate String // user's local date "YYYY-MM-DD"
  createdAt  DateTime @default(now())

  @@unique([userId, digestDate])
  @@index([userId, digestDate])
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  userId     String
  returnId   String
  statusCode String
  statusText String
  occurredAt DateTime
  location   String?
  raw        Json?
  createdAt  DateTime @default(now())

  returnItem ReturnItem @relation("ReturnItemShipmentEvents", fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId, occurredAt])
  @@index([userId, occurredAt])
}

model RefundCase {
  id                String   @id @default(cuid())
  userId            String
  returnId          String   @unique
  expectedAt        DateTime?
  receivedAt        DateTime?
  overdueNotifiedAt DateTime?
  refundType        String?  @default("ORIGINAL")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  returnItem ReturnItem @relation("ReturnItemRefundCase", fields: [returnId], references: [id], onDelete: Cascade)
}

// FX rates for currency conversion (1 base = rate quote)
model FxRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(16, 8)
  asOfDate      DateTime // usually date-only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteCurrency, baseCurrency, asOfDate])
  @@unique([baseCurrency, quoteCurrency, asOfDate])
}

model ValueEvent {
  id         String         @id @default(cuid())
  userId     String
  type       ValueEventType
  amountCents Int
  currency   String         @default("CAD")
  occurredAt DateTime
  sourceId   String?
  isEstimated Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, type])
}

//core tables being used 

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionCadence {
  MONTHLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum ReturnStatus {
  NOT_STARTED
  PACKED
  DROPPED_OFF
  REFUNDED
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String             // Clerk userId
  name         String
  amountCents  Int
  currency     String             @default("CAD")
  renewalDate  DateTime
  cadence      SubscriptionCadence @default(MONTHLY)
  status       SubscriptionStatus  @default(ACTIVE)
  cancelUrl    String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId, renewalDate])
}

model ReturnItem {
  id              String      @id @default(cuid())
  userId          String      // Clerk userId
  store           String
  itemNote        String?
  amountCents     Int?
  currency        String      @default("CAD")
  purchaseDate    DateTime
  returnWindowDays Int        @default(30)
  returnBy        DateTime
  status          ReturnStatus @default(NOT_STARTED)
  dropoffDate     DateTime?
  refundedDate    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, returnBy])
}

//schema for adding bill paid status
enum BillStatus {
  ACTIVE
  PAUSED
}

model Bill {
  id            String     @id @default(cuid())
  userId        String
  name          String
  amountCents   Int?
  currency      String     @default("CAD")
  dueDayOfMonth Int        // 1..31
  autopay       Boolean    @default(false)
  payee         String?
  notes         String?
  status        BillStatus @default(ACTIVE)

  payments      BillPayment[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId, status])
}

model BillPayment {
  id          String   @id @default(cuid())
  userId      String
  billId      String
  monthKey    String   // "YYYY-MM"
  dueDate     DateTime
  paidAt      DateTime?
  amountCents Int?
  currency    String   @default("CAD")
  notes       String?

  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([billId, monthKey])
  @@index([userId, monthKey])
}

enum Plan {
  FREE
  PRO
}

//data model for billing state
model BillingAccount {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  plan                    Plan     @default(FREE)

  stripeCustomerId        String?  @unique
  stripeSubscriptionId    String?  @unique
  stripePriceId           String?
  stripeStatus            String?
  currentPeriodEnd        DateTime?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([plan])
}
model WebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
enum EmailProvider {
  GMAIL
  UPLOAD
}
enum ReceiptUploadStatus {
  PARSED
  NEEDS_REVIEW
  FAILED
}

model ReceiptUpload {
  id          String             @id @default(cuid())
  userId      String

  filename    String
  contentType String
  sizeBytes   Int
  storagePath String

  status      ReceiptUploadStatus @default(NEEDS_REVIEW)
  extracted   Json?
  error       String?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, createdAt])
}


enum SuggestionStatus {
  NEW
  CONFIRMED
  IGNORED
}

enum SuggestionType {
  RETURN
  SUBSCRIPTION
  BILL
}

model EmailConnection {
  id           String        @id @default(cuid())
  userId       String        @unique
  provider     EmailProvider @default(GMAIL)

  emailAddress String?
  accessToken  String?
  refreshToken String?
  expiry       DateTime?
  scope        String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model EmailMessage {
  id           String        @id // Gmail messageId
  userId       String
  provider     EmailProvider @default(GMAIL)

  threadId     String?
  internalDate DateTime?
  fromEmail    String?
  subject      String?
  snippet      String?

  createdAt    DateTime      @default(now())

  @@index([userId, provider])
}

model AutomationSuggestion {
  id        String           @id @default(cuid())
  userId    String
  provider  EmailProvider    @default(GMAIL)

  primaryMessageId String?   // optional message used as dedupe key

  type      SuggestionType
  status    SuggestionStatus @default(NEW)

  merchant  String
  amountCents Int?
  currency  String           @default("CAD")
  detectedDate DateTime

  confidence String
  reasons   Json
  messageIds Json
  draft     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, type])
  @@unique([userId, primaryMessageId])
}
model EmailTransaction {
  id        String        @id @default(cuid())
  userId    String
  provider  EmailProvider @default(GMAIL)

  messageId String
  merchant  String
  fromEmail String?
  subject   String?

  purchasedAt DateTime?
  orderId     String?
  totalCents  Int?
  currency    String  @default("CAD")
  items       Json?
  rawSource   String

  createdAt DateTime @default(now())

  @@unique([provider, messageId])
  @@index([userId, merchant])
  @@index([userId, purchasedAt])
}



# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- App URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Credential encryption (REQUIRED) ---
# Protects the OAuth tokens and IMAP passwords stored in EmailConnection.
# Generate each key with:  openssl rand -base64 32
# To rotate: add SECRET_ENC_KEY_V2, bump SECRET_ENC_ACTIVE_VERSION to 2, run
# `npm run secrets:encrypt -- --apply`, then remove V1 once nothing references it.
SECRET_ENC_ACTIVE_VERSION="1"
SECRET_ENC_KEY_V1=""

# --- Cron (REQUIRED) ---
# Shared secret for /api/cron/*. These routes bypass Clerk, so this is the only
# thing protecting them. If unset, every cron request is rejected (fail closed).
# Generate with: openssl rand -base64 32
# Callers must send either `x-cron-secret: <value>` or `Authorization: Bearer <value>`.
CRON_SECRET=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- IMAP fallback (optional) ---
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASSWORD=""

{
  "name": "new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "audit:parses": "node scripts/parseAudit.mjs",
    "postinstall": "prisma generate",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.mts\"",
    "check": "npm run lint && npm run typecheck && npm run test",
    "secrets:encrypt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/encryptExistingSecrets.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.7",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "cheerio": "^1.1.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.24",
    "googleapis": "^170.0.0",
    "luxon": "^3.7.2",
    "imapflow": "^1.7.6",
    "lucide-react": "^0.474.0",
    "mailparser": "^3.9.1",
    "next": "16.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.7.0",
    "stripe": "^20.1.2",
    "swr": "^2.3.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^7.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
